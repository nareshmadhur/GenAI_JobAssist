rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.uid in ['Rw2i5BaGSoanUgeqShm6CJ9b3GB2'];
    }

    // Users can only read and write to their own data.
    // The {userId} wildcard captures the document ID, which must match
    // the authenticated user's UID (request.auth.uid).
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Signed-in users can submit their own analytics events.
    // Replace REPLACE_WITH_OWNER_UID above so only your account can read them.
    match /analytics_events/{eventId} {
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}
